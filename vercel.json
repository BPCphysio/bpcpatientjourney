{
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/clinic.js": {
      "maxDuration": 300,
      "includeFiles": "{index.html,grading/answers.json}"
    },
    "api/migrate.js": {
      "maxDuration": 120
    }
  },
  "redirects": [
    {
      "source": "/v2",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/v2/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/v2/:path*",
      "destination": "/",
      "permanent": false
    }
  ]
}
